# Copy to .env (or just export these) — all optional.

# --- AI streaming (Claude) ---
# If unset, the SDK also picks up an `ant auth login` profile.
ANTHROPIC_API_KEY=

# --- Cloud embeddings (only if you switch the embedder to "voyage" in Settings) ---
VOYAGE_API_KEY=

# --- Overrides (defaults shown) ---
# JAMGRAF_HOST=127.0.0.1
# JAMGRAF_PORT=8787
# JAMGRAF_MODEL=claude-opus-4-8
# JAMGRAF_DATA=./data
